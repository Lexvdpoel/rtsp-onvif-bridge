# Host NIC the virtual cameras hang off. Must be on the same L2 segment as
# your DHCP server and your NVR. Check with: ip -br link
# On Unraid this is usually br0.
MACVLAN_PARENT=eth0

# Name of the Docker macvlan network (created automatically if missing).
MACVLAN_NETWORK=camlan

# Addressing for that network.
#
# Docker's macvlan driver refuses to create a network without an IPv4 pool, so
# the DHCP server cannot simply be left in charge. The default below is a
# "parking" subnet that does not exist on your LAN: Docker hands each camera a
# throwaway address from it, which the camera flushes at boot before asking your
# real DHCP server for its actual address. Carrier-grade NAT space is used so the
# throwaway address cannot collide with a real device.
#
# Leave this alone unless 100.127.255.0/24 is in use on your network.
MACVLAN_SUBNET=100.127.255.0/24

# Only needed if you point MACVLAN_SUBNET at your real LAN subnet instead, for
# example to keep Docker's view of the network consistent with reality. Set
# MACVLAN_IP_RANGE to a small unused slice so Docker cannot hand out an address
# that belongs to a real device.
#   MACVLAN_SUBNET=192.168.1.0/24
#   MACVLAN_GATEWAY=192.168.1.1
#   MACVLAN_IP_RANGE=192.168.1.240/28
MACVLAN_GATEWAY=
MACVLAN_IP_RANGE=

# Icon Unraid shows for the containers. The default is fetched over the network;
# if Unraid cannot reach it you get the question-mark placeholder. A host path is
# more reliable and the file is already there after unpacking:
#   UNRAID_ICON=/mnt/user/appdata/rtsp-onvif-bridge/unraid/icon.png
UNRAID_ICON=

# Web UI port on the Docker host
WEB_PORT=8080

BRIDGE_IMAGE=rtsp-onvif-bridge:latest
