# Host NIC the virtual cameras hang off. Must be on the same L2 segment as
# your DHCP server and your UniFi console. Check with: ip -br link
MACVLAN_PARENT=eth0

# Name of the Docker macvlan network (created automatically if missing).
MACVLAN_NETWORK=camlan

# IPAM mode for that network:
#   null   -> Docker assigns no address at all; the DHCP server is in charge.
#             This is what you want. Requires MACVLAN_SUBNET to be empty.
#   docker -> Docker assigns an address from MACVLAN_SUBNET first, the camera
#             then flushes it and asks DHCP anyway. Use only if "null" is
#             unavailable on your Docker version.
MACVLAN_IPAM=null

# Only used when MACVLAN_IPAM=docker
MACVLAN_SUBNET=
MACVLAN_GATEWAY=

# Web UI port on the Docker host
WEB_PORT=8080

BRIDGE_IMAGE=rtsp-onvif-bridge:latest
